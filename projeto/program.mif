DEPTH = 256;
WIDTH = 16;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;
CONTENT BEGIN
    00 : 0210; -- LOAD B
    01 : 0011; -- ADD C
    02 : 0112; -- STORE A
    03 : 0212; -- LOAD A (readback)
    04 : 0304; -- JUMP 04
    [05..0F] : 0000;
    10 : AAAA; -- B
    11 : 5555; -- C
    12 : 0000; -- A
    [13..FF] : 0000;
END;
